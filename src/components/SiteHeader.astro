---
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => {
  const clean = path.startsWith('/') ? path.slice(1) : path;
  return `${base}${clean}`;
};

const currentPath = Astro.url.pathname;

const links = [
  { href: 'science/', label: 'Science' },
  { href: 'pipeline/', label: 'Pipeline' },
  { href: 'foundation/', label: 'Our Story' },
  { href: 'ip-protection/', label: 'IP Protection' },
  { href: 'publications/', label: 'Publications' },
  { href: 'team/', label: 'Team' },
  { href: 'investors/', label: 'For Investors' }
];
---

<header class="page-header">
  <div class="container">
    <div class="header-top">
      <a class="logo-link" href={withBase('/')}>
        <img class="site-logo" src={withBase('images/liferaft-biosciences-logo-new.png')} alt="LifeRaft Biosciences" />
      </a>

      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label="Toggle navigation">
        <span class="nav-toggle-line"></span>
        <span class="nav-toggle-line"></span>
        <span class="nav-toggle-line"></span>
      </button>

      <nav id="primary-nav" class="nav header-nav" aria-label="Primary">
      {links.map((link) => {
        const href = withBase(link.href);
        const isActive = currentPath === href || currentPath.startsWith(href);
        return <a href={href} class={isActive ? 'is-active' : undefined} aria-current={isActive ? 'page' : undefined}>{link.label}</a>;
      })}
      </nav>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.querySelector('#primary-nav');
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(isOpen));
    });
    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        nav.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
