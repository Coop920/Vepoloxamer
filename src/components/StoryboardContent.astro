---
interface Props {
  html: string;
  page?: string;
}

const { html, page } = Astro.props;

const base = import.meta.env.BASE_URL;

const withBase = (path: string) => {
  if (!path.startsWith('/')) return path;
  return `${base}${path.slice(1)}`;
};

const linkMap: Record<string, string> = {
  'Our Lead Program': '/pipeline/#why-lead-program',
  'The Science': '/science/',
  'Lead Program →': '/pipeline/#why-lead-program',
  'The Science →': '/science/',
  'Our Approach →': '/pipeline/',
  'Explore the published literature →': '/publications/',
  'Investor Inquiries': '/contact/',
  'Scientific Collaboration': '/contact/',
  'Get in Touch': '/contact/',
};

let content = html;

// Existing root-relative links/assets should respect Astro's configured base.
content = content.replace(/href="\/([^"#][^"]*)"/g, (_m, path) => {
  return `href="${withBase('/' + path)}"`;
});

content = content.replace(/src="\/([^"]*)"/g, (_m, path) => {
  return `src="${withBase('/' + path)}"`;
});

content = content.replace(/action="\/([^"]*)"/g, (_m, path) => {
  return `action="${withBase('/' + path)}"`;
});

// Convert storyboard faux buttons and placeholder links into real internal links.
for (const [label, href] of Object.entries(linkMap)) {
  const safeHref = withBase(href);

  content = content.replaceAll(
    `<div class="wf-btn-primary">${label}</div>`,
    `<a href="${safeHref}" class="wf-btn-primary">${label}</a>`
  );

  content = content.replaceAll(
    `<div class="wf-btn-secondary">${label}</div>`,
    `<a href="${safeHref}" class="wf-btn-secondary">${label}</a>`
  );

  // Preserve any additional classes/styles on storyboard publication links.
  const escapedLabel = label.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

  const placeholderLink = new RegExp(
    `<a([^>]*\\bclass="[^"]*\\bpub-link\\b[^"]*"[^>]*)href="#"([^>]*)>${escapedLabel}<\\/a>`,
    'g'
  );

  content = content.replace(
    placeholderLink,
    `<a$1href="${safeHref}"$2>${label}</a>`
  );
}

// Preserve the established homepage visual:
// molecule artwork appears only on the homepage.
if (page === 'home') {
  content = content.replace(
    /<div class="([^"]*\bwf-hero\b[^"]*)">/,
    `<div class="$1">
      <div class="wf-hero-art"></div>`
  );
}
---

<div class="page-content-wrap">
  <div class="wireframe" set:html={content}></div>
</div>